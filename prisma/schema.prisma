generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  password  String?
  avatar    String?
  age       Int?
  gender    String?
  category  String?
  income    String?
  occupation String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  documents Document[]
  issues    Issue[]
  notifications Notification[]
  activities Activity[]
}

model Document {
  id             String   @id @default(cuid())
  userId         String
  docType        String   // aadhaar, pan, passport, driving_licence, etc.
  docName        String
  fileName       String
  fileData       String   // base64 encoded - stored locally only
  mimeType       String
  extractedData  String   // JSON string of extracted fields
  healthScore    Int      @default(100)
  issueDate      String?
  expiryDate     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues         Issue[]

  @@index([userId])
  @@index([docType])
}

model Issue {
  id          String   @id @default(cuid())
  userId      String
  documentId  String?
  severity    String   // low, medium, high, critical
  category    String   // name_mismatch, dob_mismatch, address_mismatch, expired, missing, invalid_format, ocr_error
  title       String
  description String
  impact      String   // JSON string of impacts
  status      String   @default("open") // open, resolved, dismissed
  fixGuidance String?  // JSON string of correction guidance
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  type        String   // expiry, deadline, scheme, system
  title       String
  message     String
  read        Boolean  @default(false)
  actionUrl   String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model Activity {
  id          String   @id @default(cuid())
  userId      String
  action      String
  description String
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
