# ═══════════════════════════════════════════════════════════════
# DocSync India — .gitignore
# ═══════════════════════════════════════════════════════════════

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# database
/db/*.db
/db/*.db-journal

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — KEEP .env.example for reference!
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI / dev tool configs
local-*
.claude
.z-ai-config
prompt

# Logs
dev.log
dev.out.log
server.log

# Skills directory
/skills/

# Project-specific temp files
/tool-results/
/upload/
/worklog.md
/otp-test-result.png
/screenshot-*.png
/Caddyfile
/examples/

# Mini services
/mini-services/*/node_modules
