# ═══════════════════════════════════════════════════════════════
# DocSync India — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── Database (Required) ──────────────────────────────────────
DATABASE_URL=file:./db/custom.db

# ─── SMS OTP — MessageCentral (Recommended — FREE!) ─────────
# Sign up at https://www.messagecentral.com → Get 1,000 FREE OTP credits
# No DLT registration needed for India!
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_EMAIL=
MESSAGECENTRAL_PASSWORD=

# ─── SMS OTP — Fast2SMS (Alternative) ───────────────────────
# Sign up at https://www.fast2sms.com → Get API key from dashboard
# Note: Requires ₹100 wallet credit to use API routes
FAST2SMS_API_KEY=

# ─── SMS OTP — 2Factor.in (Alternative) ────────────────────
# Sign up at https://2factor.in → Get API key
TWOFACTOR_API_KEY=

# ═══════════════════════════════════════════════════════════════
# 💡 TIP: The app works in DEMO MODE without any SMS API keys!
#    OTP will be shown on screen for verification.
#    This is perfect for hackathon demos and testing.
# ═══════════════════════════════════════════════════════════════
